<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 JIT requires writable-executable memory under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The frozen gateway dlopens its _internal extension modules, and llama-server
       loads sibling dylibs through @loader_path; both trip library validation. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- The runtimes are spawned as child processes and must inherit the sandbox exemptions. -->
  <key>com.apple.security.inherit</key>
  <true/>
</dict>
</plist>
