# Dependencies
node_modules/

# Build output
dist/
out/
# Ignore build output but keep the macOS entitlements, which are signing inputs.
build/*
!build/entitlements.mac.plist
!build/entitlements.mac.inherit.plist

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# Python gateway environments and build products are rebuilt from
# pyproject.toml/uv.lock by `npm run gateway:sync` and `npm run gateway:freeze`.
runtime/amis-gateway/.venv/
runtime/amis-gateway/build/
runtime/amis-gateway/**/__pycache__/
runtime/amis-gateway/.pytest_cache/
runtime/amis-gateway/.ruff_cache/
resources/GatewayRuntime/

# Runtime executables are supplied locally; keep TokenHub's Jinja source template.
resources/RouterRuntime/
resources/TokenHubRuntime/**/tokenhub_server/
resources/TokenHubRuntime/**/llama-server
resources/TokenHubRuntime/**/*.dylib
resources/TokenHubRuntime/**/*.so
resources/TokenHubRuntime/**/*.dll
resources/TokenHubRuntime/**/*.exe

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

