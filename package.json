{
  "name": "tokiie",
  "version": "0.1.0",
  "description": "Tokiie desktop application built with Electron",
  "main": "dist/main/main.js",
  "author": "qi liu",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc && npm run build:assets",
    "build:prod": "rm -rf dist && tsc -p tsconfig.prod.json && npm run build:assets",
    "build:assets": "mkdir -p dist/renderer && cp src/renderer/index.html dist/renderer/index.html",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "gateway:sync": "uv sync --directory runtime/amis-gateway",
    "gateway:test": "uv run --directory runtime/amis-gateway --frozen pytest -q",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "yaml": "^2.9.0"
  }
}
